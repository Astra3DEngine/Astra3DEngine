{
  "name": "astra-3d-engine",
  "version": "0.1.0",
  "description": "A joking 3D engine",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Cyberexplorer",
  "homepage": "https://github.com/LanwyWriteXU/Astra3DEngine",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite --config vite.config.desktop.js",
    "desktop:build": "vite build --config vite.config.desktop.js && electron-builder",
    "desktop:preview": "electron dist-electron/main.js",
    "icon:generate": "node scripts/generate-icons.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "test": "vitest run",
    "creeper?": "echo Awwwww Man!"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "classnames": "^2.5.1",
    "file-saver": "^2.0.5",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.15",
    "three": "^0.160.0",
    "three-viewport-gizmo": "^2.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "png-to-ico": "^2.1.8",
    "prettier": "^3.9.9",
    "sharp": "^0.33.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.cyberexplorer.astra3dengine",
    "productName": "Astra 3D Engine",
    "copyright": "Copyright © 2024 Cyberexplorer All Rights Reserved.",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "installerSidebar": "electron/installerSidebar.bmp",
      "uninstallerSidebar": "electron/uninstallerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Astra 3D Engine",
      "include": "electron/installer.nsh",
      "license": "LICENSE",
      "artifactName": "${productName}-v${version}-windows-${arch}-setup.exe"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-windows-${arch}-portable.exe"
    },
    "mac": {
      "icon": "electron/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-v${version}-macos-${arch}.${ext}"
    },
    "dmg": {
      "icon": "electron/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "electron/icons",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Astra 3D Team",
      "desktop": {
        "Name": "Astra 3D Engine",
        "Comment": "A Joking 3D Engine",
        "Categories": "Development;3DGraphics;Graphics"
      },
      "artifactName": "${productName}-v${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-v${version}-linux-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "${productName}-v${version}-linux-${arch}.deb",
      "depends": [
        "gconf2",
        "gconf-service",
        "libnotify4",
        "libappindicator1"
      ]
    }
  },
  "packageManager": "pnpm@8.15.0"
}
